package views

import (
	"creator-crawler/internal/storage"
	"fmt"
)

templ GameDetailPage(data GameDetailData) {
	@Layout(data.Game.Name) {
		@GameDetailContent(data)
	}
}

templ GameDetailContent(data GameDetailData) {
	<div id="game-content">
		<section class="mb-6 flex justify-between border-b border-slate-300 pb-4">
			<div>
				<a class="mb-4 inline-block text-sm font-black uppercase" href="/games">← Games</a>
				<p class="text-xs font-black uppercase tracking-[0.18em] text-sky-700">Game</p>
				<h1 class="mt-1 text-5xl font-black uppercase leading-none tracking-tight text-slate-900 md:text-7xl">{ data.Game.Name }</h1>
				<div class="mt-4">
					@TagList(data.Tags)
				</div>
			</div>
		</section>
		@Alert("success", data.Notice)
		@Alert("error", data.Error)
		<section class="mb-4 rounded-sm border border-slate-300 bg-white p-4 shadow-[0_2px_0_rgb(203_213_225)]">
			<h2 class="mb-4 text-xl font-black uppercase text-neutral-950">Tags</h2>
			<form class="flex flex-wrap items-end gap-3 max-md:flex-col max-md:items-stretch" method="post" action={ GameTagsPath(data.Game.ID) }>
				<label class="min-w-96 max-md:min-w-0">
					<span>Comma-separated tags</span>
					<input name="tags" value={ TagsValue(data.Tags) } placeholder="Souls-like, Open World, Action RPG"/>
				</label>
				<button type="submit">Save tags</button>
			</form>
		</section>
		<section class="mb-4 rounded-sm border border-slate-300 bg-white p-4 shadow-[0_2px_0_rgb(203_213_225)]">
			<h2 class="mb-4 text-xl font-black uppercase text-neutral-950">Run YouTube search</h2>
			<form class="flex flex-wrap items-end gap-3 max-md:flex-col max-md:items-stretch" data-on:submit={ "@post('" + GameSearchesPath(data.Game.ID) + "', {contentType: 'form'})" } data-indicator="searching">
				<label>
					<span>Query</span>
					<input name="query" value={ data.SearchForm.Query } placeholder={ data.Game.Name }/>
				</label>
				<label class="w-32 max-md:w-full">
					<span>Limit</span>
					<input name="limit" type="number" min="1" max="500" value={ fmt.Sprint(data.SearchForm.Limit) }/>
				</label>
				<label class="flex min-w-80 items-center gap-2 max-md:min-w-0">
					<input class="w-auto" name="include_filtered" type="checkbox" checked?={ data.SearchForm.IncludeFiltered }/>
					<span class="mb-0 normal-case">Include likely official/media/trailer results</span>
				</label>
				<button type="submit">Run search</button>
				<span class="text-sm text-neutral-700" data-show="$searching">Searching YouTube…</span>
			</form>
		</section>
		@VideosSection(data.Game, data.Videos, data.Filters)
		@SearchRunsSection(data.Runs)
	</div>
}

templ SearchRunsSection(runs []storage.SearchRun) {
	<section class="mb-4 rounded-sm border border-slate-300 bg-white p-4 shadow-[0_2px_0_rgb(203_213_225)]">
		<h2 class="mb-4 text-xl font-black uppercase text-neutral-950">Recent searches</h2>
		if len(runs) == 0 {
			<p class="text-sm font-medium text-neutral-700">No searches run yet.</p>
		} else {
			<div class="overflow-x-auto">
			<table class="w-full border-collapse text-left text-sm text-neutral-950">
				<thead>
					<tr class="border-b border-slate-300 bg-slate-100 text-xs font-black uppercase tracking-wide text-slate-700">
						<th class="border-r border-stone-300 px-3 py-2">ID</th>
						<th class="border-r border-stone-300 px-3 py-2">Query</th>
						<th class="border-r border-stone-300 px-3 py-2">Results</th>
						<th class="border-r border-stone-300 px-3 py-2">Limit</th>
						<th class="border-r border-stone-300 px-3 py-2">Filtered</th>
						<th class="px-3 py-2">Created</th>
					</tr>
				</thead>
				<tbody>
					for _, run := range runs {
						<tr class="border-b border-slate-200 last:border-b-0 hover:bg-sky-50">
							<td class="border-r border-stone-300 px-3 py-2">{ fmt.Sprint(run.ID) }</td>
							<td class="border-r border-stone-300 px-3 py-2">{ run.Query }</td>
							<td class="border-r border-stone-300 px-3 py-2">{ FormatCount(run.ResultCount) }</td>
							<td class="border-r border-stone-300 px-3 py-2">{ FormatCount(run.LimitRequested) }</td>
							<td class="border-r border-stone-300 px-3 py-2">
								if run.IncludeFiltered {
									<span>included</span>
								} else {
									<span>excluded</span>
								}
							</td>
							<td class="px-3 py-2 text-neutral-700">{ FormatTime(run.CreatedAt) }</td>
						</tr>
					}
				</tbody>
			</table>
			</div>
		}
	</section>
}
