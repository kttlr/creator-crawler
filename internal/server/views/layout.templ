package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Creator Crawler</title>
			<link rel="stylesheet" href="/static/tailwind.css"/>
			<script type="module" src="/static/vendor/datastar.js"></script>
		</head>
		<body class="bg-stone-100 text-neutral-950">
			<aside class="fixed left-0 top-0 z-10 flex h-screen w-60 flex-col gap-8 border-r border-neutral-800 bg-stone-50 p-5 text-sm max-md:static max-md:h-auto max-md:w-auto max-md:border-r-0 max-md:border-b max-md:gap-3">
				<a class="block rounded-sm border border-neutral-800 p-3 font-black uppercase tracking-tight underline decoration-2 underline-offset-4 hover:bg-neutral-900 hover:text-stone-50" href="/">Creator Crawler</a>
				<nav class="flex flex-col gap-2 font-black uppercase max-md:flex-row max-md:flex-wrap">
					<a class="rounded-sm border border-neutral-800 bg-stone-50 px-3 py-2 hover:bg-neutral-900 hover:text-stone-50" href="/my-games">My Games</a>
					<a class="rounded-sm border border-neutral-800 bg-stone-50 px-3 py-2 hover:bg-neutral-900 hover:text-stone-50" href="/creators">Creators</a>
					<a class="rounded-sm border border-neutral-800 bg-stone-50 px-3 py-2 hover:bg-neutral-900 hover:text-stone-50" href="/games">Games</a>
				</nav>
			</aside>
			<main class="p-6 pl-[16.5rem] max-md:p-4">
				{ children... }
			</main>
		</body>
	</html>
}

templ Alert(kind string, message string) {
	if message != "" {
		if kind == "error" {
			<div class="mb-4 rounded-sm border border-neutral-800 bg-red-50 p-3 text-sm font-bold text-neutral-950">{ message }</div>
		} else {
			<div class="mb-4 rounded-sm border border-neutral-800 bg-green-50 p-3 text-sm font-bold text-neutral-950">{ message }</div>
		}
	}
}

templ StatusBadge(status string) {
	if StatusLabel(status) == "candidate" {
		<span class="inline-block rounded-sm border border-neutral-700 bg-yellow-100 px-2 py-1 text-xs font-black uppercase text-neutral-950">candidate</span>
	} else if StatusLabel(status) == "approved" {
		<span class="inline-block rounded-sm border border-neutral-700 bg-green-100 px-2 py-1 text-xs font-black uppercase text-neutral-950">approved</span>
	} else if StatusLabel(status) == "rejected" {
		<span class="inline-block rounded-sm border border-neutral-700 bg-red-100 px-2 py-1 text-xs font-black uppercase text-neutral-950">rejected</span>
	} else if StatusLabel(status) == "contacted" {
		<span class="inline-block rounded-sm border border-neutral-700 bg-blue-100 px-2 py-1 text-xs font-black uppercase text-neutral-950">contacted</span>
	} else {
		<span class="inline-block rounded-sm border border-neutral-700 bg-neutral-200 px-2 py-1 text-xs font-black uppercase text-neutral-950">{ StatusLabel(status) }</span>
	}
}
