package views

import (
	"creator-crawler/internal/storage"
	"fmt"
)

templ MyGamesPage(data MyGamesPageData) {
	@Layout("My Games") {
		<section class="mb-6 flex flex-col gap-2 border-b border-neutral-800 pb-4 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="text-xs font-black uppercase tracking-[0.18em] text-neutral-800">Portfolio</p>
				<h1 class="mt-1 text-5xl font-black uppercase leading-none tracking-tight text-neutral-950 md:text-7xl">My Games</h1>
				<p class="mt-2 max-w-2xl text-sm font-medium text-neutral-700">Save your own games, tag them, and connect them to similar tracked games and creators.</p>
			</div>
		</section>
		@Alert("error", data.Error)
		<section class="mb-4 rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
			<h2 class="mb-3 text-xl font-black uppercase text-neutral-950">Add my game</h2>
			<form class="grid gap-3" method="post" action={ MyGamesPath() }>
				<div class="grid gap-3 md:grid-cols-2">
					<label>
						<span>Name</span>
						<input name="name" required placeholder="My Deckbuilder"/>
					</label>
					<label>
						<span>Tags</span>
						<input name="tags" placeholder="Roguelike, Deckbuilder, Pixel Art"/>
					</label>
				</div>
				<label>
					<span>Description</span>
					<textarea name="description" rows="3" placeholder="Short positioning notes"></textarea>
				</label>
				<label>
					<span>Notes</span>
					<textarea name="notes" rows="3" placeholder="Marketing notes, creator fit, launch window"></textarea>
				</label>
				<div><button type="submit">Add my game</button></div>
			</form>
		</section>
		<section class="rounded-sm border border-neutral-800 bg-stone-50 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
			<div class="border-b border-neutral-800 px-4 py-3">
				<h2 class="text-xl font-black uppercase text-neutral-950">Saved games</h2>
			</div>
			if len(data.MyGames) == 0 {
				<p class="p-4 text-sm font-medium text-neutral-700">No saved games yet.</p>
			} else {
				<div class="overflow-x-auto">
					<table class="min-w-[760px] w-full border-collapse text-left text-sm text-neutral-950">
						<thead>
							<tr class="border-b border-neutral-800 bg-stone-200 text-xs font-black uppercase tracking-wide">
								<th class="px-4 py-3">Game</th>
								<th class="px-4 py-3">Tags</th>
								<th class="px-4 py-3">Similar games</th>
								<th class="px-4 py-3">Creators</th>
								<th class="px-4 py-3">Updated</th>
							</tr>
						</thead>
						<tbody>
							for _, game := range data.MyGames {
								<tr class="border-b border-stone-300 last:border-b-0 hover:bg-amber-50">
									<td class="px-4 py-3 font-black"><a href={ MyGamePath(game.ID) }>{ game.Name }</a></td>
									<td class="px-4 py-3">{ FormatCount(game.TagCount) }</td>
									<td class="px-4 py-3">{ FormatCount(game.SimilarGameCount) }</td>
									<td class="px-4 py-3">{ FormatCount(game.CreatorCount) }</td>
									<td class="px-4 py-3 text-neutral-700">{ FormatTime(game.UpdatedAt) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

templ MyGameDetailPage(data MyGameDetailData) {
	@Layout(data.MyGame.Name) {
		<section class="mb-6 border-b border-neutral-800 pb-4">
			<a class="mb-4 inline-block text-sm font-black uppercase" href={ MyGamesPath() }>← My Games</a>
			<p class="text-xs font-black uppercase tracking-[0.18em] text-neutral-800">My game</p>
			<h1 class="mt-1 text-5xl font-black uppercase leading-none tracking-tight text-neutral-950 md:text-7xl">{ data.MyGame.Name }</h1>
			if data.MyGame.Description != "" {
				<p class="mt-3 max-w-3xl text-sm font-medium text-neutral-700">{ data.MyGame.Description }</p>
			}
		</section>
		@Alert("success", data.Notice)
		@Alert("error", data.Error)
		<section class="mb-4 grid gap-4 lg:grid-cols-2">
			<div class="rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
				<h2 class="mb-3 text-xl font-black uppercase text-neutral-950">Profile</h2>
				<form class="grid gap-3" method="post" action={ MyGamePath(data.MyGame.ID) }>
					<label><span>Name</span><input name="name" value={ data.MyGame.Name } required/></label>
					<label><span>Description</span><textarea name="description" rows="3">{ data.MyGame.Description }</textarea></label>
					<label><span>Notes</span><textarea name="notes" rows="5">{ data.MyGame.Notes }</textarea></label>
					<div><button type="submit">Save profile</button></div>
				</form>
			</div>
			<div class="rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
				<h2 class="mb-3 text-xl font-black uppercase text-neutral-950">Tags</h2>
				@TagList(data.Tags)
				<form class="mt-3 grid gap-3" method="post" action={ MyGameTagsPath(data.MyGame.ID) }>
					<label><span>Comma-separated tags</span><input name="tags" value={ TagsValue(data.Tags) } placeholder="Roguelike, Deckbuilder, Pixel Art"/></label>
					<div><button type="submit">Save tags</button></div>
				</form>
			</div>
		</section>
		@MyGameConnections(data)
	}
}

templ TagList(tags []storage.Tag) {
	if len(tags) == 0 {
		<p class="text-sm font-medium text-neutral-700">No tags yet.</p>
	} else {
		<div class="flex flex-wrap gap-2">
			for _, tag := range tags {
				<span class="rounded-sm border border-neutral-700 bg-stone-100 px-2 py-1 text-xs font-black uppercase text-neutral-700">{ tag.Name }</span>
			}
		</div>
	}
}

templ MyGameConnections(data MyGameDetailData) {
	<section class="mb-4 grid gap-4 lg:grid-cols-2">
		<div class="rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
			<h2 class="mb-3 text-xl font-black uppercase text-neutral-950">Similar tracked games</h2>
			<form class="mb-4 grid gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-end" method="post" action={ MyGameSimilarGamesPath(data.MyGame.ID) }>
				<label>
					<span>Tracked game</span>
					<select name="game_id" required>
						<option value="">Choose a game</option>
						for _, game := range data.AllGames {
							<option value={ fmt.Sprint(game.ID) }>{ game.Name }</option>
						}
					</select>
				</label>
				<button type="submit">Associate</button>
			</form>
			@SimilarGameTable(data.MyGame.ID, data.SimilarGames, true)
		</div>
		<div class="rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
			<h2 class="mb-3 text-xl font-black uppercase text-neutral-950">Suggested games</h2>
			<p class="mb-3 text-sm font-medium text-neutral-700">Ranked by shared tags.</p>
			@SimilarGameTable(data.MyGame.ID, data.SuggestedGames, false)
		</div>
	</section>
	<section class="mb-4 grid gap-4 lg:grid-cols-2">
		<div class="rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
			<h2 class="mb-3 text-xl font-black uppercase text-neutral-950">Associated creators</h2>
			<form class="mb-4 grid gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-end" method="post" action={ MyGameCreatorsPath(data.MyGame.ID) }>
				<label>
					<span>Creator</span>
					<select name="channel_id" required>
						<option value="">Choose a creator</option>
						for _, creator := range data.ApprovedCreators {
							<option value={ creator.ChannelID }>{ creator.CreatorName }</option>
						}
					</select>
				</label>
				<button type="submit">Associate</button>
			</form>
			@CreatorConnectionTable(data.MyGame.ID, data.Creators, true)
		</div>
		<div class="rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
			<h2 class="mb-3 text-xl font-black uppercase text-neutral-950">Suggested creators</h2>
			<p class="mb-3 text-sm font-medium text-neutral-700">Approved/contacted creators from tracked games sharing tags with your game.</p>
			@SuggestedCreatorTable(data.MyGame.ID, data.SuggestedCreators)
		</div>
	</section>
}

templ SimilarGameTable(myGameID int64, games []storage.MyGameSimilarGame, removable bool) {
	if len(games) == 0 {
		<p class="text-sm font-medium text-neutral-700">No games found.</p>
	} else {
		<div class="overflow-x-auto">
			<table class="w-full border-collapse text-left text-sm text-neutral-950">
				<thead><tr class="border-b border-neutral-800 bg-stone-200 text-xs font-black uppercase tracking-wide text-neutral-700"><th class="px-3 py-2">Game</th><th class="px-3 py-2">Shared tags</th><th class="px-3 py-2">Approved</th><th class="px-3 py-2">Action</th></tr></thead>
				<tbody>
					for _, game := range games {
						<tr class="border-b border-stone-300 last:border-b-0 hover:bg-amber-50">
							<td class="px-3 py-2 font-black"><a href={ GamePath(game.ID) }>{ game.Name }</a></td>
							<td class="px-3 py-2">{ FormatCount(game.SharedTagCount) }</td>
							<td class="px-3 py-2">{ FormatCount(game.ApprovedCount) }</td>
							<td class="px-3 py-2">
								if removable {
									<form method="post" action={ MyGameSimilarGamePath(myGameID, game.ID) + "/remove" }><button class="text-xs" type="submit">Remove</button></form>
								} else {
									<form method="post" action={ MyGameSimilarGamesPath(myGameID) }><input type="hidden" name="game_id" value={ fmt.Sprint(game.ID) }/><button class="text-xs" type="submit">Associate</button></form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ CreatorConnectionTable(myGameID int64, creators []storage.MyGameCreator, removable bool) {
	if len(creators) == 0 {
		<p class="text-sm font-medium text-neutral-700">No creators associated yet.</p>
	} else {
		<div class="overflow-x-auto">
			<table class="w-full border-collapse text-left text-sm text-neutral-950">
				<thead><tr class="border-b border-neutral-800 bg-stone-200 text-xs font-black uppercase tracking-wide text-neutral-700"><th class="px-3 py-2">Creator</th><th class="px-3 py-2">Email</th><th class="px-3 py-2">Contacted</th><th class="px-3 py-2">Approved</th><th class="px-3 py-2">Action</th></tr></thead>
				<tbody>
					for _, creator := range creators {
						<tr class="border-b border-stone-300 last:border-b-0 hover:bg-amber-50">
							<td class="px-3 py-2 font-black"><a href={ CreatorPath(creator.ChannelID) }>{ creator.CreatorName }</a></td>
							<td class="px-3 py-2">
								if creator.Email != "" {
									<a href={ "mailto:" + creator.Email }>{ creator.Email }</a>
								} else {
									<span class="text-neutral-500">-</span>
								}
							</td>
							<td class="px-3 py-2">
								if creator.ContactedAt != "" {
									<div class="font-bold">Yes</div>
									<div class="text-xs text-neutral-700">{ FormatTime(creator.ContactedAt) }</div>
								} else {
									<span>No</span>
								}
							</td>
							<td class="px-3 py-2">{ FormatCount(creator.ApprovedVideoCount) }</td>
							<td class="px-3 py-2">
								if removable {
									<div class="flex flex-col gap-2">
										if creator.ContactedAt == "" {
											<form method="post" action={ MyGameCreatorContactedPath(myGameID, creator.ChannelID) }><input type="hidden" name="contacted" value="true"/><button class="text-xs" type="submit">Mark contacted</button></form>
										} else {
											<form method="post" action={ MyGameCreatorContactedPath(myGameID, creator.ChannelID) }><input type="hidden" name="contacted" value="false"/><button class="text-xs" type="submit">Mark uncontacted</button></form>
										}
										<form method="post" action={ MyGameCreatorPath(myGameID, creator.ChannelID) + "/remove" }><button class="text-xs" type="submit">Remove</button></form>
									</div>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ SuggestedCreatorTable(myGameID int64, creators []storage.SuggestedCreator) {
	if len(creators) == 0 {
		<p class="text-sm font-medium text-neutral-700">No suggested creators yet.</p>
	} else {
		<div class="overflow-x-auto">
			<table class="w-full border-collapse text-left text-sm text-neutral-950">
				<thead><tr class="border-b border-neutral-800 bg-stone-200 text-xs font-black uppercase tracking-wide text-neutral-700"><th class="px-3 py-2">Creator</th><th class="px-3 py-2">Email</th><th class="px-3 py-2">Shared tags</th><th class="px-3 py-2">Approved</th><th class="px-3 py-2">Action</th></tr></thead>
				<tbody>
					for _, creator := range creators {
						<tr class="border-b border-stone-300 last:border-b-0 hover:bg-amber-50">
							<td class="px-3 py-2 font-black"><a href={ CreatorPath(creator.ChannelID) }>{ creator.CreatorName }</a></td>
							<td class="px-3 py-2">
								if creator.Email != "" {
									<a href={ "mailto:" + creator.Email }>{ creator.Email }</a>
								} else {
									<span class="text-neutral-500">-</span>
								}
							</td>
							<td class="px-3 py-2">{ FormatCount(creator.SharedTagCount) }</td>
							<td class="px-3 py-2">{ FormatCount(creator.ApprovedVideoCount) }</td>
							<td class="px-3 py-2"><form method="post" action={ MyGameCreatorsPath(myGameID) }><input type="hidden" name="channel_id" value={ creator.ChannelID }/><button class="text-xs" type="submit">Associate</button></form></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
