package views

import (
	"creator-crawler/internal/storage"
	"fmt"
)

templ CreatorsPage(data CreatorsPageData) {
	@Layout("Creators") {
		<section class="mb-6 flex justify-between border-b border-neutral-800 pb-4">
			<div>
				<p class="text-xs font-black uppercase tracking-[0.18em] text-neutral-800">Approved creators</p>
				<h1 class="mt-1 text-5xl font-black uppercase leading-none tracking-tight text-neutral-950 md:text-7xl">Creators</h1>
				<p class="mt-2 max-w-2xl text-sm font-medium text-neutral-700">Creators appear here after at least one video has been approved for a tracked game.</p>
			</div>
		</section>
		<section class="mb-4 rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
			<form class="mb-4 flex flex-wrap items-end gap-3" method="get" action={ CreatorsPath() }>
				<label>
					<span>Search</span>
					<input name="q" value={ data.Filters.Query } placeholder="creator name"/>
				</label>
				<label>
					<span>Sort</span>
					<select name="sort">
						<option value="approved" selected?={ data.Filters.Sort == "approved" }>Approved videos</option>
						<option value="subscribers" selected?={ data.Filters.Sort == "subscribers" }>Subscribers</option>
						<option value="games" selected?={ data.Filters.Sort == "games" }>Games</option>
						<option value="views" selected?={ data.Filters.Sort == "views" }>Views</option>
						<option value="last_seen" selected?={ data.Filters.Sort == "last_seen" }>Last seen</option>
					</select>
				</label>
				<button type="submit">Apply</button>
			</form>
			if len(data.Creators) == 0 {
				<p class="text-sm font-medium text-neutral-700">No approved creators match these filters.</p>
			} else {
				<div class="overflow-x-auto">
					<table class="min-w-[1080px] w-full border-collapse text-left text-sm text-neutral-950">
						<thead>
							<tr class="border-b border-neutral-800 bg-stone-200 text-xs font-black uppercase tracking-wide text-neutral-700">
								<th class="border-r border-stone-300 px-3 py-2">Creator</th>
								<th class="border-r border-stone-300 px-3 py-2">Subscribers</th>
								<th class="border-r border-stone-300 px-3 py-2">Approved videos</th>
								<th class="border-r border-stone-300 px-3 py-2">Games</th>
								<th class="border-r border-stone-300 px-3 py-2">Views</th>
								<th class="px-3 py-2">Last seen</th>
							</tr>
						</thead>
						<tbody>
							for _, creator := range data.Creators {
								<tr class="border-b border-stone-300 last:border-b-0 hover:bg-amber-50">
									<td class="border-r border-stone-300 px-3 py-2"><a href={ CreatorPath(creator.ChannelID) }><strong>{ creator.CreatorName }</strong></a></td>
									<td class="border-r border-stone-300 px-3 py-2">{ FormatCount(creator.SubscriberCount) }</td>
									<td class="border-r border-stone-300 px-3 py-2">{ FormatCount(creator.ApprovedVideoCount) }</td>
									<td class="border-r border-stone-300 px-3 py-2">{ FormatCount(creator.GameCount) }</td>
									<td class="border-r border-stone-300 px-3 py-2">{ FormatCount(creator.TotalViewCount) }</td>
									<td class="px-3 py-2 text-neutral-700">{ FormatTime(creator.LastSeenAt) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

templ CreatorDetailPage(data CreatorDetailData) {
	@Layout(data.Creator.CreatorName) {
		<section class="mb-6 border-b border-neutral-800 pb-4">
			<a class="mb-4 inline-block text-sm font-black uppercase" href={ CreatorsPath() }>← Creators</a>
			<div>
				<p class="text-xs font-black uppercase tracking-[0.18em] text-neutral-800">Creator</p>
				<div>
					<div>
						<h1 class="mt-1 text-5xl font-black uppercase leading-none tracking-tight text-neutral-950 md:text-7xl">{ data.Creator.CreatorName }</h1>
						<div class="mt-4 flex flex-wrap gap-2 text-xs font-black uppercase">
							<a class="rounded-sm border border-neutral-700 bg-stone-50 px-2 py-1" href={ data.Creator.ChannelURL } target="_blank" rel="noreferrer">Open YouTube channel</a>
							if data.Creator.Email != "" {
								<a class="rounded-sm border border-neutral-700 bg-stone-50 px-2 py-1" href={ "mailto:" + data.Creator.Email }>{ data.Creator.Email }</a>
							}
							<span class="rounded-sm border border-neutral-700 bg-stone-50 px-2 py-1 text-neutral-700">{ FormatCount(data.Creator.SubscriberCount) } subscribers</span>
							<span class="rounded-sm border border-neutral-700 bg-stone-50 px-2 py-1 text-neutral-700">{ FormatCount(data.Creator.ApprovedVideoCount) } approved videos</span>
							<span class="rounded-sm border border-neutral-700 bg-stone-50 px-2 py-1 text-neutral-700">{ FormatCount(data.Creator.GameCount) } games</span>
							<span class="rounded-sm border border-neutral-700 bg-stone-50 px-2 py-1 text-neutral-700">{ FormatCount(data.Creator.TotalViewCount) } approved views</span>
						</div>
					</div>
				</div>
			</div>
		</section>
		<section class="mb-4 rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
			<h2 class="mb-3 text-xl font-black uppercase text-neutral-950">Contact info</h2>
			<form class="flex flex-wrap items-end gap-3 max-md:flex-col max-md:items-stretch" method="post" action={ CreatorEmailPath(data.Creator.ChannelID) }>
				<label class="min-w-96 max-md:min-w-0">
					<span>Email</span>
					<input name="email" type="email" value={ data.Creator.Email } placeholder="creator@example.com"/>
				</label>
				<button type="submit">Save email</button>
			</form>
		</section>
		if len(data.Games) == 0 {
			<section class="mb-4 rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]"><p class="text-sm font-medium text-neutral-700">No tracked game videos are attached to this creator yet.</p></section>
		} else {
			<div>
				for _, game := range data.Games {
					@CreatorGameSection(game)
				}
			</div>
		}
	}
}

templ CreatorGameSection(game CreatorGameGroup) {
	<section class="mb-4 rounded-sm border border-neutral-800 bg-stone-50 p-4 shadow-[2px_2px_0_rgba(38,38,38,0.18)]">
		<div class="mb-4 flex items-end justify-between gap-4">
			<div>
				<h2 class="mb-1 text-xl font-black uppercase text-neutral-950"><a href={ GamePath(game.GameID) }>{ game.Name }</a></h2>
				<p class="text-sm font-medium text-neutral-700">{ fmt.Sprint(len(game.Videos)) } videos from this creator</p>
			</div>
		</div>
		<div class="overflow-x-auto">
			<table class="min-w-[1080px] w-full border-collapse text-left text-sm text-neutral-950">
				<thead>
					<tr class="border-b border-neutral-800 bg-stone-200 text-xs font-black uppercase tracking-wide text-neutral-700">
						<th class="border-r border-stone-300 px-3 py-2">Status</th>
						<th class="border-r border-stone-300 px-3 py-2">Video</th>
						<th class="border-r border-stone-300 px-3 py-2">Views</th>
						<th class="border-r border-stone-300 px-3 py-2">Likes / comments</th>
						<th class="border-r border-stone-300 px-3 py-2">Format</th>
						<th class="border-r border-stone-300 px-3 py-2">Language</th>
						<th class="border-r border-stone-300 px-3 py-2">Published</th>
						<th class="px-3 py-2">Last seen</th>
					</tr>
				</thead>
				<tbody>
					for _, video := range game.Videos {
						@CreatorVideoRow(video)
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ CreatorVideoRow(video storage.CreatorVideo) {
	<tr class="border-b border-stone-300 last:border-b-0 hover:bg-amber-50">
		<td class="border-r border-stone-300 px-3 py-2">@StatusBadge(video.Status)</td>
		<td class="max-w-[34rem] border-r border-stone-300 px-3 py-2">
			<a href={ video.VideoURL } target="_blank" rel="noreferrer">{ video.VideoTitle }</a>
			if video.FilteredReason != "" {
				<div class="text-sm text-neutral-700">Filtered reason: { video.FilteredReason }</div>
			}
			if video.Notes != "" {
				<div class="text-sm text-neutral-700">Notes: { video.Notes }</div>
			}
		</td>
		<td class="border-r border-stone-300 px-3 py-2"><strong>{ FormatCount(video.ViewCount) }</strong></td>
		<td class="border-r border-stone-300 px-3 py-2">{ FormatCount(video.LikeCount) } / { FormatCount(video.CommentCount) }</td>
		<td class="border-r border-stone-300 px-3 py-2">{ video.Format }</td>
		<td class="border-r border-stone-300 px-3 py-2">{ video.Language }</td>
		<td class="border-r border-stone-300 px-3 py-2">{ FormatTime(video.PublishedAt) }</td>
		<td class="px-3 py-2 text-neutral-700">{ FormatTime(video.LastSeenAt) }</td>
	</tr>
}
